# Copy to .env on the host that runs the harness. Never commit the real file.
#
# ---------------------------------------------------------------------------
# DATA ACCESS (public endpoints — no key needed for OHLCV on most exchanges)
# ---------------------------------------------------------------------------
TRADELAB_EXCHANGE=binance

# ---------------------------------------------------------------------------
# PAPER TRADING
# ---------------------------------------------------------------------------
# Paper mode needs NO API keys: it reads public market data and simulates
# fills locally. If you ever find yourself putting a trading key in this file,
# stop and re-read DESIGN.md section 7.
TRADELAB_MODE=paper

# ---------------------------------------------------------------------------
# LIVE TRADING — deliberately absent.
# ---------------------------------------------------------------------------
# There are no live credentials here because there is no live code path.
# src/tradebot/execution/live.py raises on import. Enabling live trading is a
# explicit, reviewed change — not a config flag. See DESIGN.md section 7.
